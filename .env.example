# Copy to .env for local configuration; npm start does not load it automatically.
# Node >=20.6: node --env-file=.env scripts/server.mjs
GAME_AUDIO_HOST=127.0.0.1
GAME_AUDIO_PORT=4178
GAME_AUDIO_DATA_DIR=.data/audio-service
GAME_AUDIO_CONCURRENCY=1
GAME_AUDIO_RENDER_TIMEOUT_MS=180000

# Required for a non-loopback listener. Use a new random secret of >=24 characters.
# GAME_AUDIO_API_TOKEN=
# Or stable owner IDs mapped to unique random secrets; do not put real secrets in Git.
# GAME_AUDIO_API_TOKENS_JSON={"team-a":"replace-with-at-least-24-random-characters"}
# Exact cross-origin browser origins, comma separated. Backend requests need no CORS.
# GAME_AUDIO_ALLOWED_ORIGINS=https://creator.example.com

# Default commands on PATH; override with executable paths if needed.
GAME_AUDIO_FFMPEG=ffmpeg
GAME_AUDIO_FFPROBE=ffprobe
# Optional absolute path to a Playwright index.mjs installed outside this project.
# GAME_AUDIO_PLAYWRIGHT=

# Default: bounded local palette and seeded composer, with no model request.
GAME_AUDIO_DIRECTOR_PROVIDER=local
# Trusted local module takes priority over provider; version/directPrompt required.
# GAME_AUDIO_DIRECTOR_MODULE=/app/examples/algorithm-plugin.mjs

# Optional style/tempo/key director, NOT an end-to-end audio generation model.
# GAME_AUDIO_DIRECTOR_PROVIDER=openai-compatible
# GAME_AUDIO_DIRECTOR_URL=https://provider.example.com/v1/chat/completions
# GAME_AUDIO_DIRECTOR_MODEL=your-configured-model
# GAME_AUDIO_DIRECTOR_KEY=
# GAME_AUDIO_DIRECTOR_TIMEOUT_MS=30000

# Backend orchestration example only (not server settings):
# GAME_AUDIO_SERVICE_URL=http://127.0.0.1:4178
# GAME_AUDIO_EXPORT_DIR=.data/host-export
# GAME_AUDIO_RESUME_JOB=
# GAME_AUDIO_CONFIRMATION_KEY=
